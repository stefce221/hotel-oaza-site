<div class="location__top">
          <div class="location__copy">
            <div class="location__hill" aria-hidden="true">
              <svg viewBox="0 0 600 420" preserveAspectRatio="xMidYMid meet">
                <defs>
                  <path id="hill" d="M-100-10C-95-60-40-85 10-80S105-45 100 5 50 80 0 75-105 40-100-10Z"/>
                  <linearGradient id="river" x1="0" x2="1"><stop offset="0" stop-color="#05afee" stop-opacity="0"/><stop offset=".2" stop-color="#05afee"/><stop offset=".85" stop-color="#05afee"/><stop offset="1" stop-color="#05afee" stop-opacity="0"/></linearGradient>
                </defs>
                <g fill="none" stroke="#9fb6c2" stroke-width="1">
                  <use href="#hill" transform="translate(250 175) rotate(-4) scale(.28)" vector-effect="non-scaling-stroke"/>
                  <use href="#hill" transform="translate(250 177) rotate(2) scale(.52)" vector-effect="non-scaling-stroke"/>
                  <use href="#hill" transform="translate(252 180) rotate(7) scale(.78)" vector-effect="non-scaling-stroke"/>
                  <use href="#hill" transform="translate(256 184) rotate(11) scale(1.06)" vector-effect="non-scaling-stroke" opacity=".85"/>
                  <use href="#hill" transform="translate(260 190) rotate(15) scale(1.36)" vector-effect="non-scaling-stroke" opacity=".7"/>
                  <use href="#hill" transform="translate(266 198) rotate(19) scale(1.7)" vector-effect="non-scaling-stroke" opacity=".55"/>
                  <use href="#hill" transform="translate(272 206) rotate(23) scale(2.08)" vector-effect="non-scaling-stroke" opacity=".4"/>
                  <use href="#hill" transform="translate(280 216) rotate(27) scale(2.5)" vector-effect="non-scaling-stroke" opacity=".28"/>
                </g>
                <path d="M-20 392C90 360 170 408 290 380S470 318 620 350" fill="none" stroke="url(#river)" stroke-width="5" stroke-linecap="round" opacity=".32"/>
                <g transform="translate(250 175)"><circle r="16" fill="#05afee" opacity=".14"/><circle r="4.5" fill="#0077a8"/></g>
              </svg>
              <p class="location__hill-label location__hill-label--peak">{% t 'stip.isar' %}</p>
              <p class="location__hill-label location__hill-label--river">{% t 'stip.river' %}</p>
            </div>
            <p class="eyebrow" data-reveal>{% t 'stip.eyebrow' %}</p>
            <h2 class="h2" id="stip-title" data-reveal style="--d:1">{% t 'stip.title' %}</h2>
            <p class="prose" data-reveal style="--d:2">{% t 'stip.body' %}</p>
          </div>
          <div class="postcard">
            <figure class="location__media media" data-reveal="mask">
              <img src="/images/location-960.webp" srcset="/images/location-600.webp 600w, /images/location-960.webp 960w, /images/location-1296.webp 1296w"
                   sizes="(max-width: 900px) 100vw, 800px" width="1296" height="1080" loading="lazy" decoding="async"
                   alt="{% ta 'stip.alt' %}">
            </figure>
            <div class="postcard__stamp" aria-hidden="true"><span class="postcard__stamp-art"><span class="postcard__stamp-mark"></span><span class="postcard__stamp-val">MK</span></span></div>
            <svg class="postcard__postmark" viewBox="0 0 250 110" aria-hidden="true">
              <defs><path id="pm-ring" d="M190 55m-38 0a38 38 0 1 1 76 0a38 38 0 1 1-76 0"/></defs>
              <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <path d="M0 33q7-5 14 0t14 0 14 0 14 0 14 0 14 0 14 0 14 0 14 0 14 0"/>
                <path d="M0 47q7-5 14 0t14 0 14 0 14 0 14 0 14 0 14 0 14 0 14 0 14 0"/>
                <path d="M0 61q7-5 14 0t14 0 14 0 14 0 14 0 14 0 14 0 14 0 14 0 14 0"/>
                <path d="M0 75q7-5 14 0t14 0 14 0 14 0 14 0 14 0 14 0 14 0 14 0 14 0"/>
                <circle cx="190" cy="55" r="50"/>
                <circle cx="190" cy="55" r="28" stroke-width="1.2"/>
              </g>
              <text class="postcard__pm-ring"><textPath href="#pm-ring" textLength="232" lengthAdjust="spacing">{% ta 'stip.postmark' %}</textPath></text>
              <text class="postcard__pm-core" x="190" y="60" text-anchor="middle">2000</text>
            </svg>
            <p class="postcard__caption"><span>{% t 'stip.greet' %}</span><span class="postcard__coords">41°44′ N · 22°12′ E</span></p>
          </div>
        </div>
