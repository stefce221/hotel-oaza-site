<div class="halls">
          <div class="halls__head">
            <h3 class="h3" data-reveal>{% t 'halls.title' %}</h3>
            <p class="prose" data-reveal style="--d:1">{% t 'halls.sub' %}</p>
          </div>
          <ol class="halls__list">
            <li class="hall" data-reveal data-hall>
              <p class="hall__name">{% t 'hall1.name' %}</p>
              <p class="hall__cap">20–30 <small>{% t 'halls.guests' %}</small></p>
              <div class="hall__bar" style="--w:12%"></div>
              <p class="hall__uses">{% t 'hall1.uses' %}</p>
            </li>
            <li class="hall" data-reveal data-hall style="--d:1">
              <p class="hall__name">{% t 'hall2.name' %}</p>
              <p class="hall__cap">80–150 <small>{% t 'halls.guests' %}</small></p>
              <div class="hall__bar" style="--w:60%"></div>
              <p class="hall__uses">{% t 'hall2.uses' %}</p>
            </li>
            <li class="hall" data-reveal data-hall style="--d:2">
              <p class="hall__name">{% t 'hall3.name' %}</p>
              <p class="hall__cap">250 <small>{% t 'halls.guests' %}</small></p>
              <div class="hall__bar" style="--w:100%"></div>
              <p class="hall__uses">{% t 'hall3.uses' %}</p>
            </li>
          </ol>
          <div style="margin-top:3rem" data-reveal>
            <a class="btn" href="#contact" data-enquiry="wedding"><span>{% t 'events.cta' %}</span><svg class="btn__arrow" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          </div>
        </div>
