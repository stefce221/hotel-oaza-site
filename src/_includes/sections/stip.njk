      <div class="wrap">
        {% include "partials/stip-top.njk" %}

        <ol class="landmarks">
          <li class="landmark" data-reveal><{{ "h2" if titleTag == "h1" else "h3" }}>{% t 'lm1.t' %}</{{ "h2" if titleTag == "h1" else "h3" }}><p>{% t 'lm1.d' %}</p></li>
          <li class="landmark" data-reveal style="--d:1"><{{ "h2" if titleTag == "h1" else "h3" }}>{% t 'lm2.t' %}</{{ "h2" if titleTag == "h1" else "h3" }}><p>{% t 'lm2.d' %}</p></li>
          <li class="landmark" data-reveal style="--d:2"><{{ "h2" if titleTag == "h1" else "h3" }}>{% t 'lm3.t' %}</{{ "h2" if titleTag == "h1" else "h3" }}><p>{% t 'lm3.d' %}</p></li>
          <li class="landmark" data-reveal style="--d:3"><{{ "h2" if titleTag == "h1" else "h3" }}>{% t 'lm4.t' %}</{{ "h2" if titleTag == "h1" else "h3" }}><p>{% t 'lm4.d' %}</p></li>
          <li class="landmark" data-reveal style="--d:4"><{{ "h2" if titleTag == "h1" else "h3" }}>{% t 'lm5.t' %}</{{ "h2" if titleTag == "h1" else "h3" }}><p>{% t 'lm5.d' %}</p></li>
        </ol>

        {% include "partials/location-bottom.njk" %}
