<section class="aqua" id="aquabella" aria-labelledby="aqua-title">
      <div class="aqua__water" aria-hidden="true">
        <div class="aqua__caustics"></div>
        <div class="aqua__caustics aqua__caustics--b"></div>
        <span class="aqua__rope" style="top:clamp(28px, 5%, 56px)"></span>
        <span class="aqua__rope" style="bottom:clamp(28px, 5%, 56px)"></span>
      </div>

      <div class="wrap aqua__grid">
        <div class="aqua__copy">
          <p class="eyebrow" data-reveal>{% t 'aqua.eyebrow' %}</p>
          <{{ titleTag or "h2" }} class="h2" id="aqua-title" data-reveal style="--d:1">{% t 'aqua.title' %}</{{ titleTag or "h2" }}>
          <p class="prose" data-reveal style="--d:2">{% t 'aqua.body' %}</p>
          {%- if aquaLink %}
          <p class="teaser-link" data-reveal style="--d:3"><a class="link-arrow" href="{{ 'aquabella' | pageUrl(lang) }}"><span>{% t 'teaser.aqua.link' %}</span><svg aria-hidden="true"><use href="#i-arrow"/></svg></a></p>
          {%- endif %}
        </div>

        <div class="aqua__card" data-reveal style="--d:2">
          <{{ "h2" if titleTag == "h1" else "h3" }} class="h3">{% t 'aqua.card' %}</{{ "h2" if titleTag == "h1" else "h3" }}>
          <dl class="aqua__facts">
            <div class="aqua__fact"><dt>{% t 'aqua.f1' %}</dt><dd>22,000 m²</dd></div>
            <div class="aqua__fact"><dt>{% t 'aqua.f2' %}</dt><dd>3</dd></div>
            <div class="aqua__fact"><dt>{% t 'aqua.f3' %}</dt><dd>2</dd></div>
            <div class="aqua__fact"><dt>{% t 'aqua.f4' %}</dt><dd>2</dd></div>
          </dl>
          <p class="aqua__small">{% t 'aqua.small' %}</p>
        </div>
      </div>
    </section>
