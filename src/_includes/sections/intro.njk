<section class="intro section" id="about" aria-labelledby="intro-title">
      <div class="wrap intro__grid">
        <p class="eyebrow" id="intro-title" data-reveal>{% t 'intro.eyebrow' %}</p>
        <p class="statement" data-reveal style="--d:1">{% t 'intro.statement' %}</p>
        <p class="intro__side prose" data-reveal style="--d:2">{% t 'intro.side' %}</p>
      </div>

      <div class="wrap">
        <dl class="stats">
          <div class="stat" data-reveal><dt>{% t 'stat.rooms' %}</dt><dd><span data-count="57">57</span></dd></div>
          <div class="stat" data-reveal style="--d:1"><dt>{% t 'stat.halls' %}</dt><dd><span data-count="3">3</span></dd></div>
          <div class="stat" data-reveal style="--d:2"><dt>{% t 'stat.guests' %}</dt><dd><span data-count="250">250</span></dd></div>
          <div class="stat" data-reveal style="--d:3"><dt>{% t 'stat.reception' %}</dt><dd>24/7</dd></div>
          <div class="stat" data-reveal style="--d:4"><dt>{% t 'stat.aqua' %}</dt><dd><span data-count="22000">22,000</span><sup>m²</sup></dd></div>
        </dl>
      </div>
      <div class="wrap"><div class="brand-rule rule-divider" aria-hidden="true"></div></div>
    </section>
