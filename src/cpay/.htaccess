# Only the two addresses registered with CaSys are public.
Options -Indexes
<FilesMatch ".*">
  Require all denied
</FilesMatch>
<FilesMatch "^(ok|fail)\.php$">
  Require all granted
</FilesMatch>
# Refuse bodies over 64 KB before PHP sees them. LiteSpeed may ignore this line;
# the size check in lib/notice.php is the real guard.
LimitRequestBody 65536
