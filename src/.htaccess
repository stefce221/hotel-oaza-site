# Hotel Oaza on MKhost. Copied only by the live build.
# On the server cPanel adds its own PHP-version block to this file, and an upload replaces the file:
# check the PHP version after every upload (docs/owner-checklist.md).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# The old sites' addresses (2010 to 2023, from the Internet Archive) lead to the matching new page.
# test/redirects.test.mjs reads these lines; anything else from the old sites gets the 404 page.
RedirectMatch 301 "^/(about-us|blog|gallery|splash|popup-\d+|read-more-\d+|index\.htm|index_mak\.htm)/?$" "/"
RedirectMatch 301 "^/contacts/?$" "/kontakt/"
RedirectMatch 301 "^/(reservations|rezervacija\.htm)/?$" "/kontakt/?type=stay"
RedirectMatch 301 "^/privacy-policy/?$" "/privatnost/"

# Build files and other dotfiles are not public.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# FilesMatch only sees file names, so a dot-folder (/.git/config) needs this rule too.
# /.well-known/ stays open: AutoSSL renews the certificate through it.
RedirectMatch 404 "/\.(?!well-known/)"

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# CSS and JS links carry a content hash (?v=…), so they can be cached for long.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
